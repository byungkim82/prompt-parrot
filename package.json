{
  "name": "prompt-parrot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "npx @opennextjs/cloudflare build && wrangler deploy",
    "wrangler:dev": "wrangler dev",
    "db:create": "wrangler d1 create prompt-parrot-db",
    "db:migrate:local": "wrangler d1 migrations apply prompt-parrot-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply prompt-parrot-db",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.14",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250114.0",
    "@opennextjs/cloudflare": "^1.14.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "^15.1.3",
    "jsdom": "^29.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^4.1.0",
    "wrangler": "^4.53.0"
  }
}
